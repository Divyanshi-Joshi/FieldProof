# FieldProof Environment Configuration Template
# Copy this file to .env and configure your project and Gemini credentials:

# 1. Your Google Cloud Project ID (Required):
#    Create or select a project in Google Cloud Console or Google AI Studio.
FIELDPROOF_GCP_PROJECT="your-gcp-project-id"

# 2. Your Gemini API Key:
#    Create an API key associated with your project at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key-here"

# 3. Gemini Vision Model:
#    FieldProof is verified and benchmarked on gemini-3-flash-preview:
FIELDPROOF_GEMINI_MODEL="gemini-3-flash-preview"

# 4. Vertex AI & Cloud Run Deployment Regions:
FIELDPROOF_VERTEX_LOCATION="global"
CR_REGION="asia-south1"

