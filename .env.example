# FieldProof Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# FieldProof uses Vertex AI with Application Default Credentials (ADC).
# NO API KEY is used or needed. Authentication is handled by the Google Cloud
# service account attached to Cloud Run, or by your local gcloud CLI session.
#
# Local setup (one-time):
#   gcloud auth application-default login
#   gcloud config set project <YOUR_PROJECT_ID>
#
# Cloud Run: the service account fieldproof-run@<PROJECT>.iam.gserviceaccount.com
# must have roles/aiplatform.user and roles/bigquery.dataEditor granted.
# ─────────────────────────────────────────────────────────────────────────────

# 1. Your Google Cloud Project ID (Required):
#    Create or select a project in Google Cloud Console.
FIELDPROOF_GCP_PROJECT="your-gcp-project-id"

# 2. Vertex AI Location (Required):
#    Use "global" or a specific region, e.g., "us-central1", "asia-south1".
FIELDPROOF_VERTEX_LOCATION="global"

# 3. Gemini Model (Required):
#    Use a stable GA release. Do NOT use milestone/snapshot/2.5-* models.
#    The default is already set in application.yml; only set this to override.
FIELDPROOF_GEMINI_MODEL="gemini-2.0-flash-001"

# 4. Cloud Run Deployment Region (used by scripts/deploy.sh only):
CR_REGION="asia-south1"

# ── Optional tuning ──────────────────────────────────────────────────────────
# FIELDPROOF_GEMINI_TEMPERATURE="0.0"
# FIELDPROOF_GEMINI_THINKING=""
# FIELDPROOF_GEMINI_MEDIA_RES=""
# FIELDPROOF_PRICING_INPUT="0.075"    # USD per 1M input tokens
# FIELDPROOF_PRICING_OUTPUT="0.30"    # USD per 1M output tokens

# ── BigQuery (for real audit writes in production) ───────────────────────────
# FIELDPROOF_BQ_DATASET="fieldproof_audit"     # BQ dataset in your project
# FIELDPROOF_BQ_TABLE="audit_log"              # table within the dataset

# ── Live uploads (disabled by default for demo safety) ───────────────────────
# FIELDPROOF_LIVE_UPLOADS_ENABLED="true"
